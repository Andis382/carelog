APP_NAME=CareLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The default for a new account. Each person then reads the app in their own.
APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Tirane

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no setup, but the pdo_sqlite extension must be present.
# For Postgres:  DB_CONNECTION=pgsql  DB_HOST=127.0.0.1  DB_PORT=5432
#                DB_DATABASE=carelog  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

CARELOG_DEFAULT_LOCALE=sq
CARELOG_DEFAULT_TIMEZONE=Europe/Tirane

# How long somebody may take back their own dose record. A slip is a slip for
# about half an hour; after that it stands, which is what makes a carer's log
# worth anything as her account of what she did.
CARELOG_UNDO_MINUTES=30
